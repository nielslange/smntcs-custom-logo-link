{
	"name": "smntcs-custom-logo-link",
	"description": "Allows to customize the logo link.",
	"author": "Niels Lange",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Plugin",
		"SMNTCS Custom Logo Link"
	],
	"homepage": "https://github.com/nielslange/smntcs-custom-logo-link#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nielslange/smntcs-custom-logo-link.git"
	},
	"bugs": {
		"url": "https://github.com/nielslange/smntcs-custom-logo-link/issues"
	},
	"browserslist": [
		"defaults"
	],
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@wordpress/e2e-test-utils-playwright": "3.1.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/prettier-config": "4.56.0",
		"eslint": "^10.11.0",
		"npm-run-all2": "^9.0.3",
		"prettier": "npm:wp-prettier@3.9.6"
	},
	"scripts": {
		"phpcbf": "composer phpcbf",
		"phpcs": "composer phpcs",
		"phplint": "composer phplint",
		"test": "npm-run-all --parallel phpcs phplint",
		"wp-env": "wp-env",
		"wp-env:rc": "wp-env run cli sh -c 'wp core update --version=6.2-RC1 && wp core update --version=6.2-RC1 --force'",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"packageManager": "pnpm@12.8.1"
}
